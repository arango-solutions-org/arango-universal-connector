# Copy to .env and fill in. Never commit .env.

# Pipeline selection (see src/arango_connector/registry.py)
SOURCE=slack
SINK=arango

# Slack (required when SOURCE=slack). Setup: docs/sources/slack.md
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# Comma-separated channel IDs to watch
SLACK_CHANNEL_IDS=C0123ABCDEF,C0456GHIJKL

# Gmail (required when SOURCE=gmail). Setup: docs/sources/gmail.md
# service_account (Workspace, domain-wide delegation) or oauth (per-mailbox tokens)
GMAIL_AUTH_MODE=service_account
GMAIL_SERVICE_ACCOUNT_FILE=./secrets/gmail/service-account.json
# GMAIL_OAUTH_TOKEN_DIR=./secrets/gmail
GMAIL_MAILBOXES=ada@example.com,bob@example.com
# Ingest mail carrying any of these labels (IDs or names) and none of the excluded ones
GMAIL_LABELS=INBOX,SENT
GMAIL_EXCLUDE_LABELS=SPAM,TRASH,DRAFT
# thread: replies in a labelled conversation count too; message: own labels only
GMAIL_LABEL_MATCH=thread
GMAIL_POLL_INTERVAL_SECONDS=60
# First start: "now" (only new mail) or "lookback" (also the last GMAIL_INITIAL_LOOKBACK)
GMAIL_INITIAL_SYNC=now
GMAIL_INITIAL_LOOKBACK=24h
# hashed: keys use a hash of the mailbox address; plain: the address itself
GMAIL_KEY_MODE=hashed
# Privacy: set false to store headers only (no body, no snippet)
GMAIL_STORE_BODY=true
GMAIL_STORE_BCC=true
# raw: full | stripped (no body data) | none
GMAIL_RAW_MODE=stripped
# Attachments: off | metadata | content (file as base64) | text (extracted) | all
GMAIL_ATTACHMENTS=off
GMAIL_ATTACHMENT_MAX_BYTES=10485760
GMAIL_ATTACHMENT_TEXT_MAX_CHARS=1000000
# Collection the Compose connector-gmail service writes to
GMAIL_ARANGO_COLLECTION=emails

# ArangoDB
ARANGO_HOSTS=http://localhost:8529
ARANGO_USERNAME=root
# Required. Also used by docker-compose as the ArangoDB root password.
ARANGO_PASSWORD=change-me
ARANGO_DB=connector
ARANGO_COLLECTION=messages
# Where polling sources keep their sync cursors. Never subject to retention.
STATE_COLLECTION=connector_state
# Messages older than this many days are deleted, from ArangoDB and the dead-letter
# file alike. 0 disables retention.
RETENTION_DAYS=30
# expiry: each document stores its own expires_at; changing RETENTION_DAYS applies to
#         new documents (run arango-connector-reconcile-expiry for existing ones).
# age:    documents expire RETENTION_DAYS after RETENTION_AGE_FIELD; changes apply
#         to all documents at once.
RETENTION_MODE=expiry
# age mode only: created_at or ingested_at
RETENTION_AGE_FIELD=created_at

# Misc
DEAD_LETTER_PATH=./dead_letter.jsonl
LOG_LEVEL=INFO
