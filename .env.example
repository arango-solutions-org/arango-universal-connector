# Copy to .env and fill in. Never commit .env.

# Pipeline selection (see src/arango_connector/registry.py)
SOURCE=slack
SINK=arango

# Slack (required when SOURCE=slack)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# Comma-separated channel IDs to watch
SLACK_CHANNEL_IDS=C0123ABCDEF,C0456GHIJKL

# ArangoDB
ARANGO_HOSTS=http://localhost:8529
ARANGO_USERNAME=root
# Required. Also used by docker-compose as the ArangoDB root password.
ARANGO_PASSWORD=change-me
ARANGO_DB=connector
ARANGO_COLLECTION=messages
# Where polling sources keep their sync cursors. Never subject to retention.
STATE_COLLECTION=connector_state
# Messages older than this many days are deleted, from ArangoDB and the dead-letter
# file alike. 0 disables retention.
RETENTION_DAYS=30
# expiry: each document stores its own expires_at; changing RETENTION_DAYS applies to
#         new documents (run arango-connector-reconcile-expiry for existing ones).
# age:    documents expire RETENTION_DAYS after RETENTION_AGE_FIELD; changes apply
#         to all documents at once.
RETENTION_MODE=expiry
# age mode only: created_at or ingested_at
RETENTION_AGE_FIELD=created_at

# Misc
DEAD_LETTER_PATH=./dead_letter.jsonl
LOG_LEVEL=INFO
